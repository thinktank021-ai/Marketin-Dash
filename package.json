{
  "name": "marketing-dashboard-mordad",
  "version": "0.260.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "bash scripts/install-ci.sh",
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vite",
    "build": "bash scripts/build-verified.sh || npx vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "server": "node server.js",
    "setup": "node scripts/setup-wizard.mjs",
    "set-admin": "node scripts/set-admin.mjs",
    "db:restore": "node scripts/restore-backup.mjs data/dashboard-backup-donyagardi.json",
    "db:restore:novavaran": "node scripts/restore-backup.mjs data/dashboard-backup-novavaran.json",
    "db:restore:all": "node scripts/restore-backup.mjs data/dashboard-backup-donyagardi.json && node scripts/restore-backup.mjs data/dashboard-backup-novavaran.json",
    "db:backup": "node scripts/backup-db.mjs",
    "db:backup:git": "node scripts/backup-to-git.mjs",
    "brand:list": "node scripts/manage-brand.mjs list",
    "brand:add": "node scripts/manage-brand.mjs add",
    "brand:add:novavaran": "node scripts/manage-brand.mjs add novavaran 'دفتر نوآوران' 'نوآوران'",
    "test": "npm run build && NODE_OPTIONS='--experimental-loader=./scripts/cloudflare-workers-loader.mjs' node --test tests/*.test.mjs",
    "validate:artifact": "bash scripts/validate-artifact.sh",
    "lint": "bash scripts/sites-env.sh -- eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "bash scripts/sites-env.sh -- drizzle-kit generate"
  },
  "dependencies": {
    "@fontsource-variable/vazirmatn": "^5.3.0",
    "drizzle-orm": "0.45.2",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "displayName": "داشبورد مارکتینگ مرداد"
}
